#!/usr/bin/env bash
set -Eeuo pipefail

IMAGE=${PI_DOCKER_IMAGE:-pi-project-sandbox}
SOURCE=${PI_EXTENSIONS_DIR:-${HOME}/.pi-extensions}

usage() {
    cat >&2 <<'EOF'
Usage: pi-ext sync [PROJECT_DIR] | pi-ext list [PROJECT_DIR]

The curated source is ~/.pi-extensions by default. Set PI_EXTENSIONS_DIR to
use another source directory, or PI_DOCKER_VOLUME to select a volume directly.
The default volume is the same per-project volume used by pi-project.
EOF
    exit 2
}

[[ $# -ge 1 ]] || usage
COMMAND=$1
shift
[[ "$COMMAND" == sync || "$COMMAND" == list ]] || usage
[[ $# -le 1 ]] || usage

project_hash() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 256 | cut -c1-12
    elif command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | cut -c1-12
    else
        printf 'pi-ext: shasum or sha256sum is required to derive the project volume\n' >&2
        exit 1
    fi
}

if [[ -n "${PI_DOCKER_VOLUME:-}" ]]; then
    VOLUME=$PI_DOCKER_VOLUME
else
    [[ $# -eq 1 ]] || {
        printf 'pi-ext: a project directory is required unless PI_DOCKER_VOLUME is set\n' >&2
        exit 2
    }
    PROJECT_DIR=$(cd -- "$1" 2>/dev/null && pwd -P) || {
        printf 'pi-ext: project directory does not exist: %s\n' "$1" >&2
        exit 1
    }
    VOLUME="pi-project-agent-$(project_hash "$PROJECT_DIR")"
fi

if [[ "$COMMAND" == list ]]; then
    printf 'Volume: %s\n' "$VOLUME"
    printf 'Curated (%s):\n' "$SOURCE"
    if [[ -d "$SOURCE" ]]; then
        find "$SOURCE" -mindepth 1 -maxdepth 1 -print0 |
            while IFS= read -r -d '' path; do basename "$path"; done | sort
    else
        printf '(directory does not exist)\n'
    fi
    printf 'Installed:\n'
    docker run --rm --user 0:0 --network none --cap-drop=ALL --cap-add=DAC_OVERRIDE --security-opt=no-new-privileges \
        --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy" \
        --entrypoint /bin/bash "$IMAGE" \
        -euo pipefail -c '
            directory=/home/pi/.pi/agent/extensions
            if [[ -d "$directory" ]]; then
                find "$directory" -mindepth 1 -maxdepth 1 -printf "%f\\n" | sort
            fi
        '
    exit 0
fi

[[ -d "$SOURCE" ]] || {
    printf 'pi-ext: curated source directory does not exist: %s\n' "$SOURCE" >&2
    exit 1
}
docker volume create "$VOLUME" >/dev/null

# Resolve symlinks on the host first. This lets curated entries point at real
# extension content elsewhere in the host checkout while the Docker mount stays
# limited to a temporary, read-only staging directory.
staging=$(mktemp -d "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/.pi-ext.XXXXXX")
cleanup() { rm -rf "$staging"; }
trap cleanup EXIT
while IFS= read -r -d '' entry; do
    cp -R -L -- "$entry" "$staging/"
done < <(find "$SOURCE" -mindepth 1 -maxdepth 1 -print0)
find "$staging" -name '._*' -delete

# The caller-mapped runtime UID owns the volume, so prepare it once before
# copying as root. Existing unrelated extensions are preserved.
needs_prep=true
if docker run --rm --user 0:0 --network none --cap-drop=ALL --cap-add=DAC_OVERRIDE \
    --security-opt=no-new-privileges \
    --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy" \
    --entrypoint /bin/bash "$IMAGE" \
    -euo pipefail -c '[[ -f /home/pi/.pi/agent/.owner-initialized ]] && [[ "$(</home/pi/.pi/agent/.owner-initialized)" == "$1:$2" ]]' \
    -- "$(id -u)" "$(id -g)"; then
    needs_prep=false
fi
if [[ "$needs_prep" == true ]]; then
    docker run --rm --user 0:0 --network none --cap-drop=ALL --cap-add=CHOWN \
        --security-opt=no-new-privileges \
        --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy" \
        --entrypoint /bin/bash "$IMAGE" \
        -euo pipefail -c 'chown -R "$1:$2" /home/pi/.pi/agent' -- "$(id -u)" "$(id -g)"
    docker run --rm --user "$(id -u):$(id -g)" --network none --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy" \
        --entrypoint /bin/bash "$IMAGE" \
        -euo pipefail -c 'printf "%s:%s\\n" "$1" "$2" > /home/pi/.pi/agent/.owner-initialized' \
        -- "$(id -u)" "$(id -g)"
fi

docker run --rm --user 0:0 --network none --cap-drop=ALL --cap-add=CHOWN --cap-add=DAC_OVERRIDE \
    --security-opt=no-new-privileges \
    --mount "type=bind,src=${staging},dst=/source,readonly" \
    --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy" \
    --entrypoint /bin/bash "$IMAGE" \
    -euo pipefail -c '
        destination=/home/pi/.pi/agent/extensions
        mkdir -p "$destination"
        cp -a /source/. "$destination/"
        chown -R "$1:$2" "$destination"
    ' -- "$(id -u)" "$(id -g)"
printf 'Synced %s into %s (/home/pi/.pi/agent/extensions). Run /reload in pi to hot-reload.\n' \
    "$SOURCE" "$VOLUME"
