#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
# Follow symlinks so a link on PATH still finds lib/ in the checkout.
while [[ -L "$SCRIPT_PATH" ]]; do
    link=$(readlink -- "$SCRIPT_PATH")
    [[ "$link" == /* ]] || link="$(dirname -- "$SCRIPT_PATH")/$link"
    SCRIPT_PATH=$link
done
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
# shellcheck source=lib/volumes.sh
source "${SCRIPT_DIR}/lib/volumes.sh"
# shellcheck source=lib/docker.sh
source "${SCRIPT_DIR}/lib/docker.sh"
# shellcheck source=lib/egress.sh
source "${SCRIPT_DIR}/lib/egress.sh"
# shellcheck source=lib/host-files.sh
source "${SCRIPT_DIR}/lib/host-files.sh"

usage() {
    cat >&2 <<'EOF'
Usage: rapunzel [--shell] [PROJECT_DIR [pi arguments...]]
       rapunzel --exec PROJECT_DIR COMMAND [ARGS...]

PROJECT_DIR defaults to the current directory. Pi arguments need an explicit
PROJECT_DIR in front of them, for example: rapunzel . --continue

Build the image first with:
  docker build -t rapunzel .

Options:
  --shell                 Open an interactive bash with the same mounts and env.
  --exec                  Run COMMAND instead of pi, with the same mounts and env.
  -h, --help              Show this help.

Environment:
  RAPUNZEL_IMAGE          Image name (default: rapunzel)
  RAPUNZEL_VOLUME         Agent volume (default: per-project volume)
  RAPUNZEL_ENV_FILE       Optional Docker env-file containing runtime secrets
  RAPUNZEL_NETWORK        Docker network mode (default: bridge)
  RAPUNZEL_EGRESS         open (default), allowlist, or strict (docs/egress.md)
  RAPUNZEL_EGRESS_ALLOW   Extra hosts for allowlist mode, comma-separated
  RAPUNZEL_EGRESS_LOGINS  /login providers for allowlist mode, comma-separated:
                          openai, openai-codex, anthropic, github-copilot
  RAPUNZEL_EGRESS_ALLOW_PRIVATE
                          Exact hosts for allowlist mode that resolve to private
                          addresses, such as a model router on the local network
  RAPUNZEL_BASE_URL_VARIABLE
                          Variable that receives the effective base URL of
                          RAPUNZEL_API_BASE_URL, for extension providers
EOF
    exit "${1:-2}"
}

SHELL_MODE=false
EXEC_MODE=false
case "${1:-}" in
    -h | --help) usage 0 ;;
    --shell)
        SHELL_MODE=true
        shift
        ;;
    --exec)
        EXEC_MODE=true
        shift
        [[ $# -ge 2 ]] || usage
        ;;
esac

PROJECT_INPUT=.
if [[ $# -gt 0 ]]; then
    PROJECT_INPUT=$1
    shift
fi
if [[ ! -d "$PROJECT_INPUT" ]]; then
    printf 'rapunzel: project directory does not exist: %s\n' "$PROJECT_INPUT" >&2
    if [[ "$PROJECT_INPUT" == -* ]]; then
        printf 'rapunzel: put the project directory before pi arguments, for example: rapunzel . %s\n' \
            "$PROJECT_INPUT" >&2
    fi
    exit 1
fi
if [[ "$SHELL_MODE" == true && $# -gt 0 ]]; then
    printf 'rapunzel: --shell does not accept pi arguments\n' >&2
    exit 2
fi
PROJECT_DIR=$(cd -- "$PROJECT_INPUT" && pwd -P)

IMAGE=${RAPUNZEL_IMAGE:-rapunzel}
VOLUME=${RAPUNZEL_VOLUME:-$(project_volume_name "$PROJECT_DIR")}
NETWORK=${RAPUNZEL_NETWORK:-bridge}
EGRESS=${RAPUNZEL_EGRESS:-open}
if [[ -n "${RAPUNZEL_EGRESS_ALLOW_PRIVATE:-}" && "$EGRESS" != allowlist ]]; then
    printf 'rapunzel: RAPUNZEL_EGRESS_ALLOW_PRIVATE needs RAPUNZEL_EGRESS=allowlist\n' >&2
    exit 2
fi
if [[ -n "${RAPUNZEL_EGRESS_LOGINS:-}" && "$EGRESS" != allowlist ]]; then
    printf 'rapunzel: RAPUNZEL_EGRESS_LOGINS needs RAPUNZEL_EGRESS=allowlist (strict mode cannot keep /login credentials out of the sandbox)\n' >&2
    exit 2
fi
case "$EGRESS" in
    open) ;;
    allowlist | strict)
        if [[ -n "${RAPUNZEL_NETWORK:-}" ]]; then
            printf 'rapunzel: RAPUNZEL_NETWORK cannot be combined with RAPUNZEL_EGRESS=%s\n' "$EGRESS" >&2
            exit 2
        fi
        ;;
    *)
        printf 'rapunzel: RAPUNZEL_EGRESS must be open, allowlist, or strict, got: %s\n' "$EGRESS" >&2
        exit 2
        ;;
esac
RUNTIME_UID=$(id -u)
RUNTIME_GID=$(id -g)
if [[ "$RUNTIME_UID" == 0 ]]; then
    printf 'rapunzel: refusing to run pi as root; invoke it as a non-root user\n' >&2
    exit 1
fi

if [[ -n "${RAPUNZEL_ENV_FILE:-}" ]]; then
    if [[ ! -f "$RAPUNZEL_ENV_FILE" ]]; then
        printf 'rapunzel: env file does not exist: %s\n' "$RAPUNZEL_ENV_FILE" >&2
        exit 1
    fi
    env_mode=$(stat -c '%a' "$RAPUNZEL_ENV_FILE" 2>/dev/null || stat -f '%Lp' "$RAPUNZEL_ENV_FILE")
    if [[ "$env_mode" != "600" ]]; then
        printf 'rapunzel: warning: %s has mode %s; use chmod 600 for an env file containing secrets\n' \
            "$RAPUNZEL_ENV_FILE" "$env_mode" >&2
    fi
fi

require_docker rapunzel

filtered_env=""
egress_dir=""
host_files_before=""
tty_used=false
# Undo terminal modes the agent may leave behind when its own restore is lost
# or unbalanced: the kitty keyboard protocol stack (otherwise the shell gets
# keys as CSI-u sequences such as ";1:1A"), modifyOtherKeys, mouse and focus
# reporting, color-scheme notifications, a hidden cursor, and pi's fullscreen
# alternate screen. 1047 rather than 1049 leaves that screen without restoring
# a saved cursor, so it is a no-op after a clean exit.
restore_terminal() {
    [[ "$tty_used" == true && -t 1 ]] || return 0
    printf '\033[?1047l\033[<99u\033[>4;0m\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1004l\033[?2031l\033[?25h'
}
cleanup() {
    restore_terminal
    if [[ -n "$host_files_before" ]]; then
        local host_files_after
        host_files_after=$(mktemp "${TMPDIR:-/tmp}/rapunzel-files.XXXXXX")
        host_files_snapshot "$PROJECT_DIR" "$host_files_after"
        host_files_report "$host_files_before" "$host_files_after"
        rm -f "$host_files_before" "$host_files_after"
    fi
    [[ -z "$filtered_env" ]] || rm -f "$filtered_env"
    egress_stop
    [[ -z "$egress_dir" ]] || rm -rf "$egress_dir"
}
trap cleanup EXIT

# The named agent volume is created root-owned and mounted with volume-nocopy,
# so its ownership must be prepared for the invoking UID/GID on every platform.
prepare_volume_owner

args=(
    run --rm --init
    --user "${RUNTIME_UID}:${RUNTIME_GID}"
    --workdir /workspace
    --security-opt=no-new-privileges
    --cap-drop=ALL
    --mount "type=bind,src=${PROJECT_DIR},dst=/workspace"
    --mount "type=volume,src=${VOLUME},dst=/home/agent/.pi/agent,volume-nocopy"
    --env HOME=/home/agent
    --env PI_CODING_AGENT_DIR=/home/agent/.pi/agent
)
# Git config and hooks stay read-only, so pi can commit but cannot plant
# anything the host's git would run.
host_files_mounts "$PROJECT_DIR"
args+=(${HOST_FILE_MOUNTS[@]+"${HOST_FILE_MOUNTS[@]}"})

# Runtime environment policy: only allowlisted names may enter the container.
# This stops a mistaken or untrusted env file from injecting loader/interpreter
# hooks (LD_PRELOAD, BASH_ENV, NODE_OPTIONS) or overriding container paths.
env_allowlist=(
    RAPUNZEL_PROVIDER RAPUNZEL_MODEL RAPUNZEL_MODEL_ID RAPUNZEL_MODEL_NAME
    RAPUNZEL_API_BASE_URL RAPUNZEL_BASE_URL RAPUNZEL_API RAPUNZEL_API_KEY
    RAPUNZEL_API_KEY_VARIABLE RAPUNZEL_REASONING RAPUNZEL_CONTEXT_WINDOW
    RAPUNZEL_MAX_TOKENS RAPUNZEL_COMPAT_JSON RAPUNZEL_HEADERS_JSON
    RAPUNZEL_AUTH_HEADER
    ANTHROPIC_API_KEY OPENAI_API_KEY DEEPSEEK_API_KEY GEMINI_API_KEY
    OPENROUTER_API_KEY XAI_API_KEY GROQ_API_KEY MISTRAL_API_KEY
    CEREBRAS_API_KEY NVIDIA_API_KEY TOGETHER_API_KEY FIREWORKS_API_KEY
    CLOUDFLARE_API_KEY CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_GATEWAY_ID
    AI_GATEWAY_API_KEY KIMI_API_KEY MINIMAX_API_KEY MINIMAX_CN_API_KEY
    RADIUS_API_KEY HF_TOKEN BASETEN_API_KEY OPENCODE_API_KEY
    QWEN_TOKEN_PLAN_API_KEY QWEN_TOKEN_PLAN_CN_API_KEY
    HTTP_PROXY HTTPS_PROXY NO_PROXY PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
    PI_CACHE_RETENTION
)
# In strict mode the agent gets only non-secret provider settings; the
# credentials and upstream URL go to the gateway instead.
gateway_agent_allowlist=(
    RAPUNZEL_PROVIDER RAPUNZEL_MODEL RAPUNZEL_MODEL_ID RAPUNZEL_MODEL_NAME
    RAPUNZEL_API RAPUNZEL_REASONING RAPUNZEL_CONTEXT_WINDOW
    RAPUNZEL_MAX_TOKENS RAPUNZEL_COMPAT_JSON RAPUNZEL_AUTH_HEADER
    PI_CACHE_RETENTION
)
env_denylist=(
    BASH_ENV ENV LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT NODE_OPTIONS
    PYTHONSTARTUP PERL5OPT RUBYOPT
    HOME PATH TMPDIR
    PI_CODING_AGENT_DIR PI_CODING_AGENT_SESSION_DIR
)

env_name_is_valid() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }

env_name_is_denied() {
    local candidate=$1 name
    for name in "${env_denylist[@]}"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}

env_name_is_allowed() {
    local candidate=$1 name
    env_name_is_denied "$candidate" && return 1
    for name in "${env_allowlist[@]}"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}

# The custom API-key variable may be named in the host env or in the env file.
key_variable=${RAPUNZEL_API_KEY_VARIABLE:-}
if [[ -z "$key_variable" && -n "${RAPUNZEL_ENV_FILE:-}" ]]; then
    key_variable=$(grep -E '^RAPUNZEL_API_KEY_VARIABLE=' "$RAPUNZEL_ENV_FILE" | tail -n1 | cut -d= -f2- || true)
    key_variable=${key_variable%$'\r'}
fi
if [[ -n "$key_variable" ]]; then
    if ! env_name_is_valid "$key_variable" || env_name_is_denied "$key_variable"; then
        printf 'rapunzel: RAPUNZEL_API_KEY_VARIABLE is not an allowed variable name: %s\n' "$key_variable" >&2
        exit 2
    fi
    [[ "$EGRESS" == strict ]] || env_allowlist+=("$key_variable")
fi

# An extension provider (for example a model-router catalog) may read its
# endpoint from a variable of its own; this names it. rapunzel sets it to
# RAPUNZEL_API_BASE_URL, or to the gateway route in strict mode.
base_url_variable=${RAPUNZEL_BASE_URL_VARIABLE:-}
if [[ -z "$base_url_variable" && -n "${RAPUNZEL_ENV_FILE:-}" ]]; then
    base_url_variable=$(grep -E '^RAPUNZEL_BASE_URL_VARIABLE=' "$RAPUNZEL_ENV_FILE" | tail -n1 | cut -d= -f2- || true)
    base_url_variable=${base_url_variable%$'\r'}
fi
if [[ -n "$base_url_variable" ]] && { ! env_name_is_valid "$base_url_variable" || env_name_is_denied "$base_url_variable"; }; then
    printf 'rapunzel: RAPUNZEL_BASE_URL_VARIABLE is not an allowed variable name: %s\n' "$base_url_variable" >&2
    exit 2
fi

# Names the strict gateway reads; they are expected in the env and never reach pi.
gateway_consumed=(
    ANTHROPIC_API_KEY OPENAI_API_KEY RAPUNZEL_API_BASE_URL RAPUNZEL_BASE_URL
    RAPUNZEL_API_KEY_VARIABLE "${key_variable:-RAPUNZEL_API_KEY}"
    PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
)
name_in_list() {
    local candidate=$1 name
    shift
    for name in "$@"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}
# Host environment wins over the env file, matching docker's precedence.
runtime_value() {
    local name=$1 value
    if [[ -n "${!name+x}" ]]; then
        printf '%s' "${!name}"
    elif [[ -n "${RAPUNZEL_ENV_FILE:-}" ]]; then
        value=$(grep -E "^${name}=" "$RAPUNZEL_ENV_FILE" | tail -n1 | cut -d= -f2- || true)
        printf '%s' "${value%$'\r'}"
    fi
}
# Settings the egress modes manage themselves.
egress_managed=(HTTP_PROXY HTTPS_PROXY NO_PROXY PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY)
if [[ "$EGRESS" == allowlist ]]; then
    kept=()
    for name in "${env_allowlist[@]}"; do
        name_in_list "$name" "${egress_managed[@]}" || kept+=("$name")
    done
    env_allowlist=("${kept[@]}")
fi
if [[ "$EGRESS" == strict ]]; then
    unsupported=()
    for name in "${env_allowlist[@]}"; do
        if [[ -n "${!name+x}" ]] && ! name_in_list "$name" "${gateway_agent_allowlist[@]}" "${gateway_consumed[@]}"; then
            unsupported+=("$name")
        fi
    done
    if [[ ${#unsupported[@]} -gt 0 ]]; then
        printf 'rapunzel: warning: not passed with RAPUNZEL_EGRESS=strict: %s\n' "${unsupported[*]}" >&2
    fi
    env_allowlist=("${gateway_agent_allowlist[@]}")
fi

if [[ -n "${RAPUNZEL_ENV_FILE:-}" ]]; then
    filtered_env=$(mktemp "${TMPDIR:-/tmp}/rapunzel-env.XXXXXX")
    chmod 600 "$filtered_env"
    dropped=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ ! "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            printf 'rapunzel: ignoring malformed env-file line: %s\n' "$line" >&2
            continue
        fi
        name=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        if env_name_is_allowed "$name"; then
            printf '%s=%s\n' "$name" "$value" >>"$filtered_env"
        elif [[ "$EGRESS" == strict ]] && name_in_list "$name" "${gateway_consumed[@]}"; then
            continue
        elif [[ "$name" == RAPUNZEL_BASE_URL_VARIABLE ]]; then
            continue
        else
            dropped+=("$name")
        fi
    done <"$RAPUNZEL_ENV_FILE"
    if [[ ${#dropped[@]} -gt 0 ]]; then
        printf 'rapunzel: warning: dropped %d env-file variable(s) not on the allowlist: %s\n' \
            "${#dropped[@]}" "${dropped[*]}" >&2
    fi
    args+=(--env-file "$filtered_env")
fi

for name in "${env_allowlist[@]}"; do
    if [[ -n "${!name+x}" ]]; then
        args+=(--env "$name")
    fi
done

custom_url=$(runtime_value RAPUNZEL_API_BASE_URL)
[[ -n "$custom_url" ]] || custom_url=$(runtime_value RAPUNZEL_BASE_URL)
if [[ -n "$base_url_variable" && -z "$custom_url" ]]; then
    printf 'rapunzel: RAPUNZEL_BASE_URL_VARIABLE needs RAPUNZEL_API_BASE_URL\n' >&2
    exit 2
fi
base_url_value=$custom_url

if [[ "$EGRESS" != open ]]; then
    egress_dir=$(mktemp -d "${TMPDIR:-/tmp}/rapunzel-egress.XXXXXX")
    egress_networks_create
    if [[ "$EGRESS" == allowlist ]]; then
        [[ -z "$(runtime_value ANTHROPIC_API_KEY)" ]] || egress_allow_host api.anthropic.com
        [[ -z "$(runtime_value OPENAI_API_KEY)" ]] || egress_allow_host api.openai.com
        if [[ -n "$custom_url" ]]; then
            custom_host=$(url_host "$custom_url")
            egress_allow_host "$custom_host"
        fi
        # read -a splits without glob expansion, so *.example.com stays literal.
        IFS=$', \t' read -r -a logins <<<"${RAPUNZEL_EGRESS_LOGINS:-}"
        for login in ${logins[@]+"${logins[@]}"}; do
            egress_allow_login "$login"
        done
        IFS=$', \t' read -r -a extra_hosts <<<"${RAPUNZEL_EGRESS_ALLOW:-}"
        for host in ${extra_hosts[@]+"${extra_hosts[@]}"}; do
            egress_allow_host "$host"
        done
        IFS=$', \t' read -r -a private_hosts <<<"${RAPUNZEL_EGRESS_ALLOW_PRIVATE:-}"
        for host in ${private_hosts[@]+"${private_hosts[@]}"}; do
            egress_allow_private_host "$host"
        done
        allowlist_configure "$egress_dir"
        allowlist_start "$egress_dir"
        printf 'rapunzel: egress allowed to %s\n' "${EGRESS_HOSTS[*]}" >&2
        # No HTTP_PROXY: plain http:// requests have no route and fail closed.
        args+=(
            --env "HTTPS_PROXY=${EGRESS_PROXY_URL}"
            --env "https_proxy=${EGRESS_PROXY_URL}"
            --env NODE_USE_ENV_PROXY=1
        )
    else
        GW_ANTHROPIC_KEY=$(runtime_value ANTHROPIC_API_KEY)
        GW_OPENAI_KEY=$(runtime_value OPENAI_API_KEY)
        GW_CUSTOM_URL=$custom_url
        GW_CUSTOM_KEY=$(runtime_value "${key_variable:-RAPUNZEL_API_KEY}")
        GW_CUSTOM_API=$(runtime_value RAPUNZEL_API)
        gateway_configure "$egress_dir"
        gateway_start "$egress_dir"
        args+=(
            --env "RAPUNZEL_GATEWAY_URL=${GATEWAY_URL}"
            --env "RAPUNZEL_GATEWAY_PROVIDERS=${GATEWAY_PROVIDERS}"
        )
        if [[ "$GATEWAY_CUSTOM" == true ]]; then
            args+=(
                --env "RAPUNZEL_API_BASE_URL=${GATEWAY_URL}/custom"
                --env RAPUNZEL_API_KEY_VARIABLE=RAPUNZEL_API_KEY
                --env "RAPUNZEL_API_KEY=${GATEWAY_DUMMY_KEY}"
            )
            # An extension provider reading the named key variable gets the
            # placeholder too; the gateway replaces it upstream.
            if [[ -n "$key_variable" && "$key_variable" != RAPUNZEL_API_KEY ]]; then
                args+=(--env "${key_variable}=${GATEWAY_DUMMY_KEY}")
            fi
            base_url_value="${GATEWAY_URL}/custom"
        fi
    fi
    # pi.dev is not reachable from either mode; skip those requests.
    args+=(--env PI_OFFLINE=1 --env PI_SKIP_VERSION_CHECK=1 --env PI_TELEMETRY=0)
    NETWORK=$EGRESS_NETWORK
fi
if [[ -n "$base_url_variable" ]]; then
    args+=(--env "${base_url_variable}=${base_url_value}")
fi
args+=(--network "$NETWORK")

# Changes to host-executed files are reported when pi exits.
host_files_before=$(mktemp "${TMPDIR:-/tmp}/rapunzel-files.XXXXXX")
host_files_snapshot "$PROJECT_DIR" "$host_files_before"

if [[ -t 0 && -t 1 ]]; then
    args+=(--interactive --tty)
    tty_used=true
fi

if [[ "$SHELL_MODE" == true ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'rapunzel: --shell requires an interactive terminal (TTY)\n' >&2
        exit 2
    fi
    args+=(--entrypoint /usr/local/bin/rapunzel-shell)
    docker "${args[@]}" "$IMAGE"
    exit
fi

if [[ "$EXEC_MODE" == true ]]; then
    docker "${args[@]}" "$IMAGE" "$@"
    exit
fi

docker "${args[@]}" "$IMAGE" pi "$@"
