{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "mode": "full",
  "timezone": "Europe/Berlin",
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "description": "Pinned pi version in the Dockerfile and the guide",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/", "/^docs/guide\\.md$/"],
      "matchStrings": [
        "ARG PI_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "--build-arg PI_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "pinned pi version \\(currently `(?<currentValue>\\d+\\.\\d+\\.\\d+)`\\)"
      ],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Egress sidecar images in lib/egress.sh, pinned by digest",
      "customType": "regex",
      "managerFilePatterns": ["/^lib/egress\\.sh$/"],
      "matchStrings": [
        "RAPUNZEL_(?:EGRESS_PROXY|GATEWAY)_IMAGE:-(?<depName>[a-z0-9./-]+):(?<currentValue>[^@}\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\}"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "The egress sidecars are the network boundary; review every update",
      "matchFileNames": ["lib/egress.sh"],
      "automerge": false,
      "groupName": "egress sidecars",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "Wait out quick follow-up fixes; ci.yml gates every bump",
      "matchDepNames": ["@earendil-works/pi-coding-agent"],
      "minimumReleaseAge": "1 day",
      "semanticCommitType": "feat",
      "semanticCommitScope": "pi",
      "schedule": ["* 0-5 * * 1,4"]
    },
    {
      "description": "Merge pi patch releases once CI is green; 0.x minors can break and stay open for review. Renovate merges itself because main has no required checks.",
      "matchDepNames": ["@earendil-works/pi-coding-agent"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Pinned action SHAs: one weekly PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "Base image updates weekly",
      "matchManagers": ["dockerfile"],
      "schedule": ["* 0-5 * * 1"]
    }
  ]
}
