# Optional runtime configuration for a custom OpenAI-compatible provider.
# Copy to a local, untracked file and fill in real values.
PI_DOCKER_PROVIDER=omniroute
PI_DOCKER_API_BASE_URL=https://api.example.invalid/v1
PI_DOCKER_API=openai-completions
PI_DOCKER_MODEL=cx/gpt-5.6-luna
PI_DOCKER_API_KEY_VARIABLE=PI_DOCKER_API_KEY
PI_DOCKER_API_KEY=replace-me

# Optional provider behavior.
# PI_DOCKER_REASONING=true
# PI_DOCKER_CONTEXT_WINDOW=272000
# PI_DOCKER_MAX_TOKENS=16384
# PI_DOCKER_AUTH_HEADER=true
# PI_DOCKER_COMPAT_JSON={"supportsDeveloperRole":false}
# PI_DOCKER_HEADERS_JSON={"x-example":"$EXAMPLE_HEADER"}

# Built-in provider keys are also supported, for example:
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me

# A provider from a pi extension (for example a model-router catalog) that
# reads its own variables: name them instead of setting PI_DOCKER_PROVIDER.
# PI_DOCKER_API_BASE_URL=https://router.example.invalid/v1
# PI_DOCKER_BASE_URL_VARIABLE=ROUTER_BASE_URL
# PI_DOCKER_API_KEY_VARIABLE=ROUTER_API_KEY
# ROUTER_API_KEY=replace-me
