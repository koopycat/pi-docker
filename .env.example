# Optional runtime configuration for a custom OpenAI-compatible provider.
# Copy to a local, untracked file and fill in real values.
RAPUNZEL_PROVIDER=omniroute
RAPUNZEL_API_BASE_URL=https://api.example.invalid/v1
RAPUNZEL_API=openai-completions
RAPUNZEL_MODEL=cx/gpt-5.6-luna
RAPUNZEL_API_KEY_VARIABLE=RAPUNZEL_API_KEY
RAPUNZEL_API_KEY=replace-me

# Optional provider behavior.
# RAPUNZEL_REASONING=true
# RAPUNZEL_CONTEXT_WINDOW=272000
# RAPUNZEL_MAX_TOKENS=16384
# RAPUNZEL_AUTH_HEADER=true
# RAPUNZEL_COMPAT_JSON={"supportsDeveloperRole":false}
# RAPUNZEL_HEADERS_JSON={"x-example":"$EXAMPLE_HEADER"}

# Built-in provider keys are also supported, for example:
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me

# Claude Code harness (--harness claude): a host subscription login from
# `claude setup-token`, passed per run and never stored in the volume.
# CLAUDE_CODE_OAUTH_TOKEN=replace-me

# Codex harness (--harness codex): OPENAI_API_KEY above, or CODEX_API_KEY.
# A ChatGPT login is done inside the sandbox with `codex login --device-auth`.
# CODEX_API_KEY=replace-me

# A provider from a pi extension (for example a model-router catalog) that
# reads its own variables: name them instead of setting RAPUNZEL_PROVIDER.
# RAPUNZEL_API_BASE_URL=https://router.example.invalid/v1
# RAPUNZEL_BASE_URL_VARIABLE=ROUTER_BASE_URL
# RAPUNZEL_API_KEY_VARIABLE=ROUTER_API_KEY
# ROUTER_API_KEY=replace-me
