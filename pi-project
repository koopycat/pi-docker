#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
# Follow symlinks so a link on PATH still finds lib/ in the checkout.
while [[ -L "$SCRIPT_PATH" ]]; do
    link=$(readlink -- "$SCRIPT_PATH")
    [[ "$link" == /* ]] || link="$(dirname -- "$SCRIPT_PATH")/$link"
    SCRIPT_PATH=$link
done
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
# shellcheck source=lib/volumes.sh
source "${SCRIPT_DIR}/lib/volumes.sh"
# shellcheck source=lib/egress.sh
source "${SCRIPT_DIR}/lib/egress.sh"

usage() {
    cat >&2 <<'EOF'
Usage: pi-project [--shell] [PROJECT_DIR [pi arguments...]]
       pi-project --exec PROJECT_DIR COMMAND [ARGS...]

PROJECT_DIR defaults to the current directory. Pi arguments need an explicit
PROJECT_DIR in front of them, for example: pi-project . --continue

Build the image first with:
  docker build -t pi-project-sandbox .

Options:
  --shell                 Open an interactive bash with the same mounts and env.
  --exec                  Run COMMAND instead of pi, with the same mounts and env.
  -h, --help              Show this help.

Environment:
  PI_DOCKER_IMAGE         Image name (default: pi-project-sandbox)
  PI_DOCKER_VOLUME        Agent volume (default: per-project volume)
  PI_DOCKER_ENV_FILE      Optional Docker env-file containing runtime secrets
  PI_DOCKER_NETWORK       Docker network mode (default: bridge)
  PI_DOCKER_EGRESS        open (default), allowlist, or strict (docs/egress.md)
  PI_DOCKER_EGRESS_ALLOW  Extra hosts for allowlist mode, comma-separated
EOF
    exit "${1:-2}"
}

SHELL_MODE=false
EXEC_MODE=false
case "${1:-}" in
    -h | --help) usage 0 ;;
    --shell)
        SHELL_MODE=true
        shift
        ;;
    --exec)
        EXEC_MODE=true
        shift
        [[ $# -ge 2 ]] || usage
        ;;
esac

PROJECT_INPUT=.
if [[ $# -gt 0 ]]; then
    PROJECT_INPUT=$1
    shift
fi
if [[ ! -d "$PROJECT_INPUT" ]]; then
    printf 'pi-project: project directory does not exist: %s\n' "$PROJECT_INPUT" >&2
    if [[ "$PROJECT_INPUT" == -* ]]; then
        printf 'pi-project: put the project directory before pi arguments, for example: pi-project . %s\n' \
            "$PROJECT_INPUT" >&2
    fi
    exit 1
fi
if [[ "$SHELL_MODE" == true && $# -gt 0 ]]; then
    printf 'pi-project: --shell does not accept pi arguments\n' >&2
    exit 2
fi
PROJECT_DIR=$(cd -- "$PROJECT_INPUT" && pwd -P)

IMAGE=${PI_DOCKER_IMAGE:-pi-project-sandbox}
VOLUME=${PI_DOCKER_VOLUME:-$(project_volume_name "$PROJECT_DIR")}
NETWORK=${PI_DOCKER_NETWORK:-bridge}
EGRESS=${PI_DOCKER_EGRESS:-open}
case "$EGRESS" in
    open) ;;
    allowlist | strict)
        if [[ -n "${PI_DOCKER_NETWORK:-}" ]]; then
            printf 'pi-project: PI_DOCKER_NETWORK cannot be combined with PI_DOCKER_EGRESS=%s\n' "$EGRESS" >&2
            exit 2
        fi
        ;;
    *)
        printf 'pi-project: PI_DOCKER_EGRESS must be open, allowlist, or strict, got: %s\n' "$EGRESS" >&2
        exit 2
        ;;
esac
RUNTIME_UID=$(id -u)
RUNTIME_GID=$(id -g)
if [[ "$RUNTIME_UID" == 0 ]]; then
    printf 'pi-project: refusing to run pi as root; invoke it as a non-root user\n' >&2
    exit 1
fi

if [[ -n "${PI_DOCKER_ENV_FILE:-}" ]]; then
    if [[ ! -f "$PI_DOCKER_ENV_FILE" ]]; then
        printf 'pi-project: env file does not exist: %s\n' "$PI_DOCKER_ENV_FILE" >&2
        exit 1
    fi
    env_mode=$(stat -c '%a' "$PI_DOCKER_ENV_FILE" 2>/dev/null || stat -f '%Lp' "$PI_DOCKER_ENV_FILE")
    if [[ "$env_mode" != "600" ]]; then
        printf 'pi-project: warning: %s has mode %s; use chmod 600 for an env file containing secrets\n' \
            "$PI_DOCKER_ENV_FILE" "$env_mode" >&2
    fi
fi

filtered_env=""
egress_dir=""
cleanup() {
    [[ -z "$filtered_env" ]] || rm -f "$filtered_env"
    egress_stop
    [[ -z "$egress_dir" ]] || rm -rf "$egress_dir"
}
trap cleanup EXIT

# The named agent volume is created root-owned and mounted with volume-nocopy,
# so its ownership must be prepared for the invoking UID/GID on every platform.
prepare_volume_owner

args=(
    run --rm --init
    --user "${RUNTIME_UID}:${RUNTIME_GID}"
    --workdir /workspace
    --security-opt=no-new-privileges
    --cap-drop=ALL
    --mount "type=bind,src=${PROJECT_DIR},dst=/workspace"
    --mount "type=volume,src=${VOLUME},dst=/home/pi/.pi/agent,volume-nocopy"
    --env HOME=/home/pi
    --env PI_CODING_AGENT_DIR=/home/pi/.pi/agent
)

# Runtime environment policy: only allowlisted names may enter the container.
# This stops a mistaken or untrusted env file from injecting loader/interpreter
# hooks (LD_PRELOAD, BASH_ENV, NODE_OPTIONS) or overriding container paths.
env_allowlist=(
    PI_DOCKER_PROVIDER PI_DOCKER_MODEL PI_DOCKER_MODEL_ID PI_DOCKER_MODEL_NAME
    PI_DOCKER_API_BASE_URL PI_DOCKER_BASE_URL PI_DOCKER_API PI_DOCKER_API_KEY
    PI_DOCKER_API_KEY_VARIABLE PI_DOCKER_REASONING PI_DOCKER_CONTEXT_WINDOW
    PI_DOCKER_MAX_TOKENS PI_DOCKER_COMPAT_JSON PI_DOCKER_HEADERS_JSON
    PI_DOCKER_AUTH_HEADER
    ANTHROPIC_API_KEY OPENAI_API_KEY DEEPSEEK_API_KEY GEMINI_API_KEY
    OPENROUTER_API_KEY XAI_API_KEY GROQ_API_KEY MISTRAL_API_KEY
    CEREBRAS_API_KEY NVIDIA_API_KEY TOGETHER_API_KEY FIREWORKS_API_KEY
    CLOUDFLARE_API_KEY CLOUDFLARE_ACCOUNT_ID CLOUDFLARE_GATEWAY_ID
    AI_GATEWAY_API_KEY KIMI_API_KEY MINIMAX_API_KEY MINIMAX_CN_API_KEY
    RADIUS_API_KEY HF_TOKEN BASETEN_API_KEY OPENCODE_API_KEY
    QWEN_TOKEN_PLAN_API_KEY QWEN_TOKEN_PLAN_CN_API_KEY
    HTTP_PROXY HTTPS_PROXY NO_PROXY PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
    PI_CACHE_RETENTION
)
# In strict mode the agent gets only non-secret provider settings; the
# credentials and upstream URL go to the gateway instead.
gateway_agent_allowlist=(
    PI_DOCKER_PROVIDER PI_DOCKER_MODEL PI_DOCKER_MODEL_ID PI_DOCKER_MODEL_NAME
    PI_DOCKER_API PI_DOCKER_REASONING PI_DOCKER_CONTEXT_WINDOW
    PI_DOCKER_MAX_TOKENS PI_DOCKER_COMPAT_JSON PI_DOCKER_AUTH_HEADER
    PI_CACHE_RETENTION
)
env_denylist=(
    BASH_ENV ENV LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT NODE_OPTIONS
    PYTHONSTARTUP PERL5OPT RUBYOPT
    HOME PATH TMPDIR
    PI_CODING_AGENT_DIR PI_CODING_AGENT_SESSION_DIR
)

env_name_is_valid() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }

env_name_is_denied() {
    local candidate=$1 name
    for name in "${env_denylist[@]}"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}

env_name_is_allowed() {
    local candidate=$1 name
    env_name_is_denied "$candidate" && return 1
    for name in "${env_allowlist[@]}"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}

# The custom API-key variable may be named in the host env or in the env file.
key_variable=${PI_DOCKER_API_KEY_VARIABLE:-}
if [[ -z "$key_variable" && -n "${PI_DOCKER_ENV_FILE:-}" ]]; then
    key_variable=$(grep -E '^PI_DOCKER_API_KEY_VARIABLE=' "$PI_DOCKER_ENV_FILE" | tail -n1 | cut -d= -f2- || true)
    key_variable=${key_variable%$'\r'}
fi
if [[ -n "$key_variable" ]]; then
    if ! env_name_is_valid "$key_variable" || env_name_is_denied "$key_variable"; then
        printf 'pi-project: PI_DOCKER_API_KEY_VARIABLE is not an allowed variable name: %s\n' "$key_variable" >&2
        exit 2
    fi
    [[ "$EGRESS" == strict ]] || env_allowlist+=("$key_variable")
fi

# Names the strict gateway reads; they are expected in the env and never reach pi.
gateway_consumed=(
    ANTHROPIC_API_KEY OPENAI_API_KEY PI_DOCKER_API_BASE_URL PI_DOCKER_BASE_URL
    PI_DOCKER_API_KEY_VARIABLE "${key_variable:-PI_DOCKER_API_KEY}"
    PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
)
name_in_list() {
    local candidate=$1 name
    shift
    for name in "$@"; do
        [[ "$candidate" == "$name" ]] && return 0
    done
    return 1
}
# Host environment wins over the env file, matching docker's precedence.
runtime_value() {
    local name=$1 value
    if [[ -n "${!name+x}" ]]; then
        printf '%s' "${!name}"
    elif [[ -n "${PI_DOCKER_ENV_FILE:-}" ]]; then
        value=$(grep -E "^${name}=" "$PI_DOCKER_ENV_FILE" | tail -n1 | cut -d= -f2- || true)
        printf '%s' "${value%$'\r'}"
    fi
}
# Settings the egress modes manage themselves.
egress_managed=(HTTP_PROXY HTTPS_PROXY NO_PROXY PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY)
if [[ "$EGRESS" == allowlist ]]; then
    kept=()
    for name in "${env_allowlist[@]}"; do
        name_in_list "$name" "${egress_managed[@]}" || kept+=("$name")
    done
    env_allowlist=("${kept[@]}")
fi
if [[ "$EGRESS" == strict ]]; then
    unsupported=()
    for name in "${env_allowlist[@]}"; do
        if [[ -n "${!name+x}" ]] && ! name_in_list "$name" "${gateway_agent_allowlist[@]}" "${gateway_consumed[@]}"; then
            unsupported+=("$name")
        fi
    done
    if [[ ${#unsupported[@]} -gt 0 ]]; then
        printf 'pi-project: warning: not passed with PI_DOCKER_EGRESS=strict: %s\n' "${unsupported[*]}" >&2
    fi
    env_allowlist=("${gateway_agent_allowlist[@]}")
fi

if [[ -n "${PI_DOCKER_ENV_FILE:-}" ]]; then
    filtered_env=$(mktemp "${TMPDIR:-/tmp}/pi-project-env.XXXXXX")
    chmod 600 "$filtered_env"
    dropped=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%$'\r'}
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ ! "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            printf 'pi-project: ignoring malformed env-file line: %s\n' "$line" >&2
            continue
        fi
        name=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        if env_name_is_allowed "$name"; then
            printf '%s=%s\n' "$name" "$value" >>"$filtered_env"
        elif [[ "$EGRESS" == strict ]] && name_in_list "$name" "${gateway_consumed[@]}"; then
            continue
        else
            dropped+=("$name")
        fi
    done <"$PI_DOCKER_ENV_FILE"
    if [[ ${#dropped[@]} -gt 0 ]]; then
        printf 'pi-project: warning: dropped %d env-file variable(s) not on the allowlist: %s\n' \
            "${#dropped[@]}" "${dropped[*]}" >&2
    fi
    args+=(--env-file "$filtered_env")
fi

for name in "${env_allowlist[@]}"; do
    if [[ -n "${!name+x}" ]]; then
        args+=(--env "$name")
    fi
done

if [[ "$EGRESS" != open ]]; then
    egress_dir=$(mktemp -d "${TMPDIR:-/tmp}/pi-project-egress.XXXXXX")
    custom_url=$(runtime_value PI_DOCKER_API_BASE_URL)
    [[ -n "$custom_url" ]] || custom_url=$(runtime_value PI_DOCKER_BASE_URL)
    egress_networks_create
    if [[ "$EGRESS" == allowlist ]]; then
        [[ -z "$(runtime_value ANTHROPIC_API_KEY)" ]] || egress_allow_host api.anthropic.com
        [[ -z "$(runtime_value OPENAI_API_KEY)" ]] || egress_allow_host api.openai.com
        if [[ -n "$custom_url" ]]; then
            custom_host=$(url_host "$custom_url")
            egress_allow_host "$custom_host"
        fi
        # read -a splits without glob expansion, so *.example.com stays literal.
        IFS=$', \t' read -r -a extra_hosts <<<"${PI_DOCKER_EGRESS_ALLOW:-}"
        for host in ${extra_hosts[@]+"${extra_hosts[@]}"}; do
            egress_allow_host "$host"
        done
        allowlist_configure "$egress_dir"
        allowlist_start "$egress_dir"
        printf 'pi-project: egress allowed to %s\n' "${EGRESS_HOSTS[*]}" >&2
        # No HTTP_PROXY: plain http:// requests have no route and fail closed.
        args+=(
            --env "HTTPS_PROXY=${EGRESS_PROXY_URL}"
            --env "https_proxy=${EGRESS_PROXY_URL}"
            --env NODE_USE_ENV_PROXY=1
        )
    else
        GW_ANTHROPIC_KEY=$(runtime_value ANTHROPIC_API_KEY)
        GW_OPENAI_KEY=$(runtime_value OPENAI_API_KEY)
        GW_CUSTOM_URL=$custom_url
        GW_CUSTOM_KEY=$(runtime_value "${key_variable:-PI_DOCKER_API_KEY}")
        GW_CUSTOM_API=$(runtime_value PI_DOCKER_API)
        gateway_configure "$egress_dir"
        gateway_start "$egress_dir"
        args+=(
            --env "PI_DOCKER_GATEWAY_URL=${GATEWAY_URL}"
            --env "PI_DOCKER_GATEWAY_PROVIDERS=${GATEWAY_PROVIDERS}"
        )
        if [[ "$GATEWAY_CUSTOM" == true ]]; then
            args+=(
                --env "PI_DOCKER_API_BASE_URL=${GATEWAY_URL}/custom"
                --env PI_DOCKER_API_KEY_VARIABLE=PI_DOCKER_API_KEY
                --env "PI_DOCKER_API_KEY=${GATEWAY_DUMMY_KEY}"
            )
        fi
    fi
    # pi.dev is not reachable from either mode; skip those requests.
    args+=(--env PI_OFFLINE=1 --env PI_SKIP_VERSION_CHECK=1 --env PI_TELEMETRY=0)
    NETWORK=$EGRESS_NETWORK
fi
args+=(--network "$NETWORK")

if [[ -t 0 && -t 1 ]]; then
    args+=(--interactive --tty)
fi

if [[ "$SHELL_MODE" == true ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'pi-project: --shell requires an interactive terminal (TTY)\n' >&2
        exit 2
    fi
    args+=(--entrypoint /usr/local/bin/pi-docker-shell)
    docker "${args[@]}" "$IMAGE"
    exit
fi

if [[ "$EXEC_MODE" == true ]]; then
    docker "${args[@]}" "$IMAGE" "$@"
    exit
fi

docker "${args[@]}" "$IMAGE" pi "$@"
